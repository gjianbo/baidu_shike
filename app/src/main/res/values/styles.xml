<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/onAccent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
    </style>



    <style name="HeadAction">
        <item name="android:background">@drawable/bg_switch</item>
        <item name="android:textColor">@color/accentInk</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="ItemTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="ItemMeta">
        <item name="android:textColor">@color/ink3</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingSub">
        <item name="android:textColor">@color/ink3</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="SearchSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/slide_out_down</item>
    </style>

    <!-- PdfViewerFragment 的 ToolBoxView 使用 Material3 属性 -->
    <!-- 目录弹窗跟随暗黑主题：DayNight 才会让 alertDialogTheme / colorSurface 走夜间变体；
         写死 Light 时目录 ListView 的浅色文字会落在白色弹窗上，完全看不清。 -->
    <style name="PdfReaderTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!-- 图片预览固定黑底，避免启动瞬间露出浅色窗口背景 -->
    <style name="ImageViewerTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
