<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_sheet"
    android:orientation="vertical"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/searchInputTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.01"
            android:text="搜索文件库"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/searchInputSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink3"
            android:textSize="11.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_search_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/ink3" />

        <EditText
            android:id="@+id/searchInput"
            android:importantForAutofill="no"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="输入文件名关键词"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink3"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchScopeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="范围"
            android:textColor="@color/ink3"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/scopeDisk"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_on"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="我的网盘"
            android:textColor="@color/accentInk"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scopeGroup"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="群组"
            android:textColor="@color/ink2"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scopeAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minHeight="36dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="全部"
            android:textColor="@color/ink2"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/scopeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/ink3"
        android:textSize="10.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/searchInputCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="取消"
            android:textColor="@color/ink2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/searchInputSubmit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_search_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="搜索"
            android:textColor="@color/onAccent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
