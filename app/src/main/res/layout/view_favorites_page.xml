<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:lineSpacingMultiplier="1.6"
        android:padding="12dp"
        android:text="收藏只保存在本机：点文件或目录右侧的星标加入收藏，点标题打开，再点星标取消。"
        android:textColor="@color/ink2"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/favCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink2"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="建议 ≤ 8 个"
            android:textColor="@color/ink3"
            android:textSize="10.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/favEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingMultiplier="1.6"
        android:paddingTop="26dp"
        android:paddingBottom="14dp"
        android:text="还没有收藏。\n点文件或目录右侧的星标，就能收藏到这里。"
        android:textColor="@color/ink3"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/favList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/favGoBrowse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:drawableStart="@drawable/ic_folder"
        android:drawablePadding="6dp"
        android:gravity="center"
        android:padding="12dp"
        android:text="去群目录看看"
        android:textColor="@color/accentInk"
        android:textSize="11.5sp" />
</LinearLayout>
