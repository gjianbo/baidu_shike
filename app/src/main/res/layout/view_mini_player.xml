<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/miniPlayer"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mini_player_pill"
    android:elevation="10dp"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingTop="6dp"
    android:paddingRight="4dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/miniCover"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_fmt_audio"
            android:padding="8dp"
            android:src="@drawable/ic_music" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="9dp">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink3"
                android:textSize="9.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/miniPlay"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="播放"
            android:padding="10dp"
            android:src="@drawable/ic_play" />

        <ImageView
            android:id="@+id/miniClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="关闭播放"
            android:padding="9dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/miniProgress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginLeft="43dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="5dp"
        android:background="@color/barTrack"
        android:orientation="horizontal">

        <View
            android:id="@+id/miniFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/accent" />

        <View
            android:id="@+id/miniBarRest"
            android:layout_width="0dp"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
