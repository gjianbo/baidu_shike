<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recCard"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginRight="8dp"
    android:background="@drawable/bg_rec_card"
    android:minHeight="118dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/recIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_fmt_audio"
            android:padding="5dp" />

        <TextView
            android:id="@+id/recLib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/ink3"
            android:textSize="9.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/recName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/recBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:background="@color/barTrack"
        android:orientation="horizontal">

        <View
            android:id="@+id/recFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/accent" />

        <View
            android:id="@+id/recBarRest"
            android:layout_width="0dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <TextView
        android:id="@+id/recMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textColor="@color/ink3"
        android:textSize="10sp" />
</LinearLayout>
