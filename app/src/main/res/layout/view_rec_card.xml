<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recCard"
    android:layout_width="138dp"
    android:layout_height="wrap_content"
    android:layout_marginRight="9dp"
    android:background="@drawable/bg_rec_card"
    android:orientation="vertical"
    android:padding="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/recIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:padding="2dp" />

        <TextView
            android:id="@+id/recLib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ink3"
            android:textSize="9.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/recName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/recBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="7dp"
        android:background="@color/barTrack"
        android:orientation="horizontal">

        <View
            android:id="@+id/recFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/accent" />

        <View
            android:id="@+id/recBarRest"
            android:layout_width="0dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <TextView
        android:id="@+id/recMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/ink3"
        android:textSize="9.5sp" />
</LinearLayout>
