<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collectorFolderSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_floating"
    android:clipToOutline="true"
    android:elevation="18dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/collectorFolderDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:text="选择上传目录"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/collectorFolderPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ink3"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/collectorFolderClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            app:tint="@color/ink2" />
    </LinearLayout>

    <TextView
        android:id="@+id/collectorFolderUp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_outline_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="返回上一级"
        android:textColor="@color/ink2"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/collectorFolderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="10dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:textColor="@color/ink3"
        android:textSize="11.5sp" />

    <ListView
        android:id="@+id/collectorFolderList"
        android:layout_width="match_parent"
        android:layout_height="228dp"
        android:background="@drawable/bg_soft_row"
        android:clipToPadding="false"
        android:divider="@color/line"
        android:dividerHeight="1dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/collectorFolderCreate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_chip_on"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="＋ 新建文件夹"
        android:textColor="@color/accentInk"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/collectorFolderCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="取消"
            android:textColor="@color/ink2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/collectorFolderConfirm"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.35"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="保存到此处"
            android:textColor="@color/onAccent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
