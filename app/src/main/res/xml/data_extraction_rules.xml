<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup=false 已经关掉云备份；但 Android 12+ 的 D2D 迁移（device-transfer）
  不受它管辖，不显式排除就会把登录会话、播放记录、目录缓存整体搬到新设备。
  这里逐个 domain 全部排除，语义与 allowBackup=false 保持一致。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
